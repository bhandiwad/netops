  "fault_scenarios": [
    {
      "id": "szr_canal_fibre_cut",
      "title": "Metro Trunk Fibre Cut + Hidden SRLG Backup Failure (Sheikh Zayed Rd Canal)",
      "category": "Fibre Cut / Multi-Vendor Storm",
      "operators": [
        "du_converged",
        "constl_fiber",
        "vi_india",
        "pccw_subsea"
      ],
      "summary": "Civil excavation near Dubai Water Canal severs trunk cable CBL-QZ-BB-01 at 62% along QZ->BB. Triggers a 28-alarm storm across Ciena MCP (OMS/OCh LOS), Cisco ASR & Juniper MX (BFD/BGP/ISIS down), VIAVI ONMSi (1625nm OTDR reflective break), NMSWorks CygNet, and Ericsson ENM (hub site gNB-BB-01 + 2 downstream 5G tail sites cascading dark). Exposes a critical SRLG failure: Jebel Ali Logistics Cloud's '1+1 protected' 100G wavelength had BOTH working and protect legs routed through the QZ-BB span.",
      "fault_type": "fibre_cut",
      "target_cable": "CBL-QZ-BB-01",
      "cut_ratio": 0.62
    },
    {
      "id": "difc_gate_srlg_cut",
      "title": "Dual-Homed Bank HQ Outage via Shared Manhole Chamber (DIFC Gate SRLG Violation)",
      "category": "Enterprise SLA / False Diversity",
      "operators": [
        "constl_fiber",
        "du_converged"
      ],
      "summary": "Third-party contractor damages duct D-DG-EGB outside DIFC Gate Chamber (J_DG). Emirates Gulf Bank HQ purchased a Platinum 'Dual-POP Diverse 10G L3VPN' (primary to DIFC POP, secondary to Business Bay POP), but Lepton GIS geometry reveals both cables CBL-DIFC-EGB-01 and CBL-BB-EGB-01 enter the same last-mile chamber J_DG\u2014taking down both legs simultaneously.",
      "fault_type": "duct_cut",
      "target_duct": "D-DG-EGB",
      "cut_ratio": 0.45
    },
    {
      "id": "al_quoz_dying_gasp_vs_cut",
      "title": "Premises Power Blackout ('Dying Gasp') vs. Fibre Cut Disambiguation (Al Quoz)",
      "category": "GPON / Smart-Grid Triage",
      "operators": [
        "vi_india",
        "du_converged",
        "constl_fiber"
      ],
      "summary": "24 industrial ONTs and smart-grid modems in Al Quoz Industrial Area drop offline within 800ms, followed by gNB-DSO-04 AC mains failure. Instead of dispatching a fibre splicing crew, the copilot correlates TR-069/OLT 'dying-gasp' power-off frames and VIAVI OTDR clean continuity trace on CBL-QZ-AQI-01 to prove a substation power outage\u2014cancelling an unnecessary OSP fibre truck roll.",
      "fault_type": "power_outage",
      "target_node": "C_AQI",
      "target_cable": "CBL-QZ-AQI-01"
    },
    {
      "id": "dso_optical_degradation",
      "title": "Pre-Failure DWDM Optical OSNR & Pre-FEC BER Degradation (Silicon Oasis AI DC)",
      "category": "Predictive Optical / DCI Assurance",
      "operators": [
        "pccw_subsea",
        "constl_fiber",
        "du_converged"
      ],
      "summary": "Before any hard link down occurs on Oasis Sovereign AI DC's 100G DCI wavelength (OCH-SODC-AIR), Nokia NSP streaming telemetry reports Pre-FEC BER degrading from 1.2e-6 to 8.4e-4 and OSNR dropping 4.8 dB due to a high-loss pinched splice on CBL-AIR-DSO-01\u2014allowing proactive hitless wavelength reroute via Karama.",
      "fault_type": "optical_degradation",
      "target_cable": "CBL-AIR-DSO-01",
      "cut_ratio": 0.38
    },
    {
      "id": "ran_site_battery_lvd_countdown",
      "title": "5G Hub Site Rectifier AC Mains Loss & Battery LVD Countdown (gNB-BB-01)",
      "category": "Mobile RAN / Site Power",
      "operators": [
        "du_converged",
        "vi_india"
      ],
      "summary": "Commercial 3-phase AC mains fails at Business Bay 5G Hub site (gNB-BB-01). Ericsson ENM reports rectifier AC loss and DC bus discharging on VRLA battery bank (44.1V, LVD cut-off at 43.2V, 36 mins remaining). If LVD trips, gNB-BB-01 and 2 daisy-chained 5G tail sites (9 cells total) will go dark. Copilot correlates 3GPP PM counters and dispatches mobile diesel generator before LVD disconnect.",
      "fault_type": "ran_battery_lvd",
      "target_node": "RAN_BB_HUB"
    },
    {
      "id": "eband_microwave_rain_fade",
      "title": "80 GHz E-Band Microwave Rain-Fade vs. Hardware Fault (Academic City gNB-DSO-04)",
      "category": "Mobile RAN / Microwave Transport",
      "operators": [
        "vi_india",
        "du_converged"
      ],
      "summary": "Intense convective rain squall (42 mm/hr) crosses Silicon Oasis & Academic City. Microwave link MW-DSO-ACAD-80G drops RSL from -38 dBm to -69 dBm and downshifts ACM modulation from 1024QAM (10 Gbps) to QPSK (650 Mbps). Copilot correlates correlated weather fade across adjacent links and suppresses a false ODU/transceiver hardware replacement truck roll.",
      "fault_type": "microwave_rain_fade",
      "target_node": "RAN_DSO_MW1"
    },
    {
      "id": "pccw_subsea_shunt_fault",
      "title": "Subsea Wet-Plant Repeater Shunt Fault & C-OTDR Localization (Jebel Ali CLS)",
      "category": "Subsea Wet-Plant / Wholesale DCI",
      "operators": [
        "pccw_subsea",
        "du_converged"
      ],
      "summary": "Power Feed Equipment (PFE-JBL-01) at Jebel Ali Cable Landing Station detects a high-resistance insulation shunt fault on subsea cable SUBSEA-FALCON-JBL-MUM (+4,120V drops to +2,890V at 0.95A constant current). Coherent OTDR (C-OTDR) localizes the wet-plant shunt 14.2 km seaward of Repeater R07 (Span 7-8, 68m depth). Copilot switches PFE to single-end feeding and reroutes 400G DCI traffic over diverse terrestrial/subsea path.",
      "fault_type": "subsea_shunt",
      "target_node": "JBL"
    }
